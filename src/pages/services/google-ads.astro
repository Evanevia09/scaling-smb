---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { brand, contact, contactFormServiceOptions } from '../../content/site';
import ConsultationBooking from '../../components/landing/ConsultationBooking.astro';
import CtaBand from '../../components/landing/CtaBand.astro';
import Footer from '../../components/landing/Footer.astro';
import Header from '../../components/Header.astro';
import businessGrowthImg from '../../Images/blog-featured-images/Business Growth.jpeg';
import aiEmployeesImg from '../../Images/blog-featured-images/AI Employees.jpeg';
import softwareDevImg from '../../Images/blog-featured-images/sofware-development.jpeg';
const { scheduling } = contact;
// --- data ---
const pageTitle = 'Adz — AI-Powered Google Ads Management | Scaling SMB';
const pageDesc =
	'Your campaigns. Running daily. Optimized hourly. Audited constantly. An AI-powered Google Ads strategist that monitors, optimizes, and reports — every single day. No agency bloat. No monthly updates that come too late.';
---
<BaseLayout title={pageTitle} description={pageDesc}>
	<Header />
	<main id="main" class="service-page">
		<!-- Hero -->
		<section class="hero-inner">
			<div class="hero-inner__bg" aria-hidden="true">
				<img src={businessGrowthImg.src} alt="" class="hero-bg-img" />
			</div>
			<div class="content-wrap hero-inner__body">
				<p class="eyebrow hero-inner__eyebrow">Adz — AI Google Ads Agent</p>
				<h1 class="hero-inner__title">
					Your campaigns.<br />Running daily.<br />Optimized hourly.<br />Audited constantly.
				</h1>
				<p class="hero-inner__subtitle">
					An AI-powered Google Ads strategist built for scaling service businesses. I connect directly to
					your account, audit everything, and optimize every day — so your budget works harder than your competitors.
				</p>
				<a class="btn btn--primary hero-inner__cta" href="#book">Book a free audit →</a>
			</div>
		</section>

		<!-- The Problem -->
		<section class="section section--light">
			<div class="content-wrap">
				<header class="section-header">
					<p class="eyebrow">The real problem</p>
					<h2>Why most Google Ads money burns</h2>
					<p class="section-header__lede">
						Most businesses don't lose money on Google Ads because the platform doesn't work. They lose money because nobody's watching.
					</p>
				</header>
				<ul class="problem-list">
					<li class="problem-item">
						<span class="problem-icon prob-icon--drift">⇢</span>
						<div>
							<strong>Keywords drift</strong> — your ad shows up for searches you never intended
						</div>
					</li>
					<li class="problem-item">
						<span class="problem-icon prob-icon--outbid">⇢</span>
						<div>
							<strong>Competitors outbid you</strong> while you're not looking
						</div>
					</li>
					<li class="problem-item">
						<span class="problem-icon prob-icon--bleed">⇢</span>
						<div>
							<strong>Budget bleeds</strong> on irrelevant searches that have nothing to do with what you actually sell
						</div>
					</li>
					<li class="problem-item">
						<span class="problem-icon prob-icon--tracking">⇢</span>
						<div>
							<strong>Conversion tracking breaks</strong> and weeks go by before anyone notices
						</div>
					</li>
					<li class="problem-item">
						<span class="problem-icon prob-icon--agency">⇢</span>
						<div>
							<strong>Agency updates come monthly</strong> — by then, you've already burned through your budget
						</div>
					</li>
				</ul>
				<p class="problem-punch">
					You don't need more "best practices." You need someone actually in your account every day.
				</p>
			</div>
		</section>

		<!-- What Is Adz -->
		<section class="section section--dark">
			<div class="content-wrap">
				<header class="section-header">
					<p class="eyebrow">Meet Adz</p>
					<h2>An AI strategist that never sleeps</h2>
					<p class="section-header__lede">
						I connect directly to your Google Ads account through the API — the same pipeline Google's own engineers use.
						I audit, strategize, build, launch, monitor, and optimize. Every day.
					</p>
				</header>
				<div class="adz-what">
					<div class="adz-what__cards cols-3">
						<article class="card-tagline card-tagline--accent">
							<div class="card-icon">🌙</div>
							<h3 class="card-tagline__title">I don't sleep</h3>
							<p class="card-tagline__desc">
								No weekends. No holidays. No pipeline of 30 other clients I'm juggling. Your account gets my full attention, every day.
							</p>
						</article>
						<article class="card-tagline card-tagline--accent">
							<div class="card-icon">⚡</div>
							<h3 class="card-tagline__title">I act — not just report</h3>
							<p class="card-tagline__desc">
								When I find a leak, I flag it and fix it. No waiting for a monthly call. No "we'll include that in next quarter's plan."
							</p>
						</article>
						<article class="card-tagline card-tagline--accent">
							<div class="card-icon">🔍</div>
							<h3 class="card-tagline__title">Full transparency</h3>
							<p class="card-tagline__desc">
								You get search term reports, channel breakdowns, and every recommendation backed by real data. No black boxes. No hiding.
							</p>
						</article>
					</div>
					<div class="adz-what__visual">
						<img src={aiEmployeesImg.src} alt="AI-powered dashboard visualization" class="adz-what__img" loading="lazy" />
					</div>
				</div>
			</div>
		</section>

		<!-- What I Deliver -->
		<section class="section section--light">
			<div class="content-wrap">
				<header class="section-header">
					<p class="eyebrow">What I deliver</p>
					<h2>From audit to daily optimization</h2>
				</header>

				<div class="deliver-stack">
					<article class="deliver-card">
						<div class="deliver-card__header">
							<span class="deliver-card__step">01</span>
							<h3 class="deliver-card__title">Audit — Before You Spend Another Dollar</h3>
						</div>
						<p class="deliver-card__desc">
							I pull 90 days of data from your account and find every leak within an hour:
						</p>
						<ul class="deliver-card__list">
							<li>Search terms wasting your budget</li>
							<li>Missing negative keywords</li>
							<li>Broken conversion tracking</li>
							<li>Campaign structure problems</li>
							<li>Bidding strategy mismatches</li>
						</ul>
						<p class="deliver-card__outcome"><strong>Deliverable:</strong> A written audit with specific dollars wasted and exactly what to fix.</p>
					</article>

					<article class="deliver-card">
						<div class="deliver-card__header">
							<span class="deliver-card__step">02</span>
							<h3 class="deliver-card__title">Strategy — Built From Real Data</h3>
						</div>
						<p class="deliver-card__desc">
							I research your market through Google's own Keyword Planning API — real search volumes and CPCs, not third-party estimates. Then I build a campaign structure designed for how your customers actually search.
						</p>
						<ul class="deliver-card__list">
							<li>Thematic ad groups (not SKAGs)</li>
							<li>Exact + Phrase + Broad match layered with negatives</li>
							<li>Ad copy tested against competitor angles</li>
							<li>Landing page alignment verified</li>
						</ul>
					</article>

					<article class="deliver-card">
						<div class="deliver-card__header">
							<span class="deliver-card__step">03</span>
							<h3 class="deliver-card__title">Build & Launch — 48 Hours</h3>
						</div>
						<p class="deliver-card__desc">
							Everything is built inside your account via API. Paused, ready for your review. You approve, I launch. Within 48 hours of your sign-off, your campaigns are live.
						</p>
					</article>

					<article class="deliver-card">
						<div class="deliver-card__header">
							<span class="deliver-card__step">04</span>
							<h3 class="deliver-card__title">Daily Monitoring</h3>
						</div>
						<p class="deliver-card__desc">
							Every morning you get a report:
						</p>
						<ul class="deliver-card__list">
							<li>What spent and what converted</li>
							<li>New search terms that showed up — good and bad</li>
							<li>Recommendations for what to add or block</li>
						</ul>
						<p class="deliver-card__outcome">No meetings. No status calls. Just data and action items.</p>
					</article>

					<article class="deliver-card">
						<div class="deliver-card__header">
							<span class="deliver-card__step">05</span>
							<h3 class="deliver-card__title">Weekly Optimization</h3>
						</div>
						<p class="deliver-card__desc">
							Search term review → add winners, kill losers. Ad copy refresh → swap underperformers. Budget reallocation → move spend to what's working.
						</p>
					</article>

					<article class="deliver-card">
						<div class="deliver-card__header">
							<span class="deliver-card__step">06</span>
							<h3 class="deliver-card__title">Monthly Deep-Dive</h3>
						</div>
						<ul class="deliver-card__list">
							<li>Bid strategy review → graduate to Smart Bidding when you have enough conversion data</li>
							<li>Full account health check</li>
							<li>Conversion tracking verification — tested across every layer</li>
						</ul>
					</article>
				</div>
			</div>
		</section>

		<!-- The Black Box Warning -->
		<section class="section section--dark">
			<div class="content-wrap">
				<header class="section-header">
					<p class="eyebrow">The Black Box Warning</p>
					<h2>You deserve to know where every dollar went</h2>
					<p class="section-header__lede" style="max-width:48rem">
						Google's Performance Max campaigns are a black box. You give Google your budget and get back conversions — but you never see where your money actually went. We don't run black boxes. You get search term reports. You get channel breakdowns. You get to see exactly what's working.
					</p>
				</header>
			</div>
		</section>

		<!-- Pricing -->
		<section class="section section--light" id="pricing">
			<div class="content-wrap">
				<header class="section-header">
					<p class="eyebrow">Pricing</p>
					<h2>Simple, transparent, no surprises</h2>
					<p class="section-header__lede">
						<strong>No percentage of ad spend. No markup on your budget. No platform fees.</strong>
						Just a flat monthly retainer and a one-time setup.
					</p>
				</header>
				<div class="pricing-grid">
					<article class="pricing-card pricing-card--featured">
						<div class="pricing-card__badge">Most popular</div>
						<h3 class="pricing-card__tier">Starter</h3>
						<p class="pricing-card__revenue">For monthly ad spend up to $1,000</p>
						<div class="pricing-card__value">
							<span class="pricing-card__amount">$300</span>
							<span class="pricing-card__label">/month</span>
						</div>
						<div class="pricing-card__setup">
							+ <strong>$297</strong> one-time setup
						</div>
						<ul class="pricing-card__features">
							<li>Full account audit</li>
							<li>Campaign setup & launch</li>
							<li>Daily monitoring</li>
							<li>Weekly optimization</li>
							<li>Monthly deep-dive report</li>
						</ul>
						<a class="btn btn--primary pricing-card__btn" href="#book">Book a free audit →</a>
					</article>
					<article class="pricing-card pricing-card--featured">
						<h3 class="pricing-card__tier">Growth</h3>
						<p class="pricing-card__revenue">For monthly ad spend $1,000 – $5,000</p>
						<div class="pricing-card__value">
							<span class="pricing-card__amount">$500</span>
							<span class="pricing-card__label">/month</span>
						</div>
						<div class="pricing-card__setup">
							+ <strong>$297</strong> one-time setup
						</div>
						<ul class="pricing-card__features">
							<li>Everything in Starter</li>
							<li>Competitor analysis</li>
							<li>Weekly ad copy refresh</li>
							<li>A/B testing</li>
						</ul>
						<a class="btn btn--primary pricing-card__btn" href="#book">Book a free audit →</a>
					</article>
					<article class="pricing-card pricing-card--featured">
						<h3 class="pricing-card__tier">Scale</h3>
						<p class="pricing-card__revenue">For monthly ad spend $5,000+</p>
						<div class="pricing-card__value">
							<span class="pricing-card__amount">Contact us</span>
						</div>
						<div class="pricing-card__setup">
							Custom retainer + <strong>$297</strong> setup
						</div>
						<ul class="pricing-card__features">
							<li>Everything in Growth</li>
							<li>Dedicated strategy</li>
							<li>Advanced reporting</li>
							<li>Priority support</li>
						</ul>
						<a class="btn btn--primary pricing-card__btn" href="#book">Book a free audit →</a>
					</article>
				</div>
			</div>
		</section>

		<!-- Agency Cost Comparison -->
		<section class="section section--dark" id="compare">
			<div class="content-wrap">
				<header class="section-header">
					<p class="eyebrow">Compare for yourself</p>
					<h2>Adz vs a traditional agency</h2>
					<p class="section-header__lede">
						Most agencies charge 10–20% of your ad spend or a $1,000+ monthly retainer — and you only hear from them once a month.
					</p>
				</header>

				<div class="compare-layout">
					<div class="compare-visual">
						<img src={softwareDevImg.src} alt="Cost comparison visualization" class="compare-img" loading="lazy" />
					</div>

					<div class="compare-table-wrap">
						<table class="compare-table">
							<thead>
								<tr>
									<th></th>
									<th class="compare-th compare-th--bad">Traditional Agency</th>
									<th class="compare-th compare-th--good">Adz — AI Agent</th>
								</tr>
							</thead>
							<tbody>
								<tr>
									<td class="compare-label">Monthly retainer</td>
									<td class="compare-cell compare-cell--bad">$1,000 – $3,000</td>
									<td class="compare-cell compare-cell--good">$300 – $500</td>
								</tr>
								<tr>
									<td class="compare-label">Setup fee</td>
									<td class="compare-cell compare-cell--bad">$500 – $1,500</td>
									<td class="compare-cell compare-cell--good">$297</td>
								</tr>
								<tr>
									<td class="compare-label">% of ad spend</td>
									<td class="compare-cell compare-cell--bad">10–20%</td>
									<td class="compare-cell compare-cell--good">0%</td>
								</tr>
								<tr>
									<td class="compare-label">Account access</td>
									<td class="compare-cell compare-cell--bad">Monthly updates</td>
									<td class="compare-cell compare-cell--good">Daily monitoring</td>
								</tr>
								<tr>
									<td class="compare-label">Search term review</td>
									<td class="compare-cell compare-cell--bad">Monthly</td>
									<td class="compare-cell compare-cell--good">Weekly (live)</td>
								</tr>
								<tr>
									<td class="compare-label">Ad copy refresh</td>
									<td class="compare-cell compare-cell--bad">Quarterly</td>
									<td class="compare-cell compare-cell--good">Weekly</td>
								</tr>
								<tr>
									<td class="compare-label">Response time</td>
									<td class="compare-cell compare-cell--bad">Business hours</td>
									<td class="compare-cell compare-cell--good">24/7</td>
								</tr>
							</tbody>
						</table>
					</div>
				</div>

				<div class="compare-savings" style="text-align:center;margin-top:2rem">
					<p class="compare-savings__line"><strong>Typical annual savings with Adz:</strong> <span class="compare-savings__amount">$8,000 – $30,000+</span> vs a traditional agency.</p>
					<p class="compare-savings__sub">And you get better service. That's not a trade-off — that's just how it works when you remove agency overhead.</p>
				</div>
			</div>
		</section>

		<!-- How We Start -->
		<section class="section section--light">
			<div class="content-wrap">
				<header class="section-header">
					<p class="eyebrow">How we start</p>
					<h2>From hello to live campaigns</h2>
				</header>
				<div class="process-simple">
					<article class="process-step">
						<div class="process-step__num-wrap">
							<span class="process-step__icon">🛠️</span>
							<span class="process-step__number">01</span>
						</div>
						<div class="process-step__body">
							<h3 class="process-step__title">You sign up for a Google Ads account</h3>
							<p class="process-step__desc">Use your business email at ads.google.com and add your billing info.</p>
						</div>
					</article>
					<article class="process-step">
						<div class="process-step__num-wrap">
							<span class="process-step__icon">🔗</span>
							<span class="process-step__number">02</span>
						</div>
						<div class="process-step__body">
							<h3 class="process-step__title">Link to our MCC</h3>
							<p class="process-step__desc">We send the request, you accept. We're in your account within minutes.</p>
						</div>
					</article>
					<article class="process-step">
						<div class="process-step__num-wrap">
							<span class="process-step__icon">📋</span>
							<span class="process-step__number">03</span>
						</div>
						<div class="process-step__body">
							<h3 class="process-step__title">Audit (or build from scratch)</h3>
							<p class="process-step__desc">Within 24 hours, we pull 90 days of data and find every leak. Or if you're starting fresh, we build campaigns from the ground up.</p>
						</div>
					</article>
					<article class="process-step">
						<div class="process-step__num-wrap">
							<span class="process-step__icon">🚀</span>
							<span class="process-step__number">04</span>
						</div>
						<div class="process-step__body">
							<h3 class="process-step__title">You review, approve, we launch</h3>
							<p class="process-step__desc">Total setup time: 48 hours from your sign-off. After that, daily monitoring begins.</p>
						</div>
					</article>
				</div>
				<div class="how-start__cta" style="text-align:center;margin-top:2rem">
					<a class="btn btn--primary" href="#book">Start with a free audit →</a>
				</div>
			</div>
		</section>

		<!-- The tech section -->
		<section class="section section--dark">
			<div class="content-wrap">
				<header class="section-header">
					<p class="eyebrow">The tech behind Adz</p>
					<h2>How it actually works</h2>
				</header>
				<div class="tech-list">
					<article class="tech-item">
						<div class="tech-icon-wrap">📖</div>
						<div>
							<h3 class="tech-item__title">Read your account</h3>
							<p class="tech-item__desc">GAQL queries via Google Ads API</p>
						</div>
					</article>
					<article class="tech-item">
						<div class="tech-icon-wrap">🔧</div>
						<div>
							<h3 class="tech-item__title">Build campaigns</h3>
							<p class="tech-item__desc">Full mutation support — budgets, keywords, ads, extensions</p>
						</div>
					</article>
					<article class="tech-item">
						<div class="tech-icon-wrap">🔍</div>
						<div>
							<h3 class="tech-item__title">Research keywords</h3>
							<p class="tech-item__desc">KeywordPlanIdeaService — real volumes, CPCs, competition</p>
						</div>
					</article>
					<article class="tech-item">
						<div class="tech-icon-wrap">✅</div>
						<div>
							<h3 class="tech-item__title">Check tracking</h3>
							<p class="tech-item__desc">GTM API + Analytics Data API + live page verification</p>
						</div>
					</article>
					<article class="tech-item">
						<div class="tech-icon-wrap">🎯</div>
						<div>
							<h3 class="tech-item__title">Optimize bids</h3>
							<p class="tech-item__desc">Bidding strategy changes via CampaignService + FieldMasks</p>
						</div>
					</article>
					<article class="tech-item">
						<div class="tech-icon-wrap">📱</div>
						<div>
							<h3 class="tech-item__title">Monitor daily</h3>
							<p class="tech-item__desc">Cron-delivered reports to your phone</p>
						</div>
					</article>
					<article class="tech-item">
						<div class="tech-icon-wrap">🔄</div>
						<div>
							<h3 class="tech-item__title">Stay current</h3>
							<p class="tech-item__desc">Self-updating — checks Google's docs daily and patches itself</p>
						</div>
					</article>
				</div>
			</div>
		</section>

		<!-- The non-commodity difference -->
		<section class="section section--light">
			<div class="content-wrap">
				<header class="section-header">
					<p class="eyebrow">Our edge</p>
					<h2>Non-commodity ad copy</h2>
					<p class="section-header__lede">
						Most Google Ads use generic templates that look and sound the same. We write ads that can't be
						replicated — because they're built on your actual business data.
					</p>
				</header>
				<div class="cols-2">
					<div>
						<h3 class="compare-heading">Typical Google Ads agency</h3>
						<ul class="checklist checklist--muted">
							<li class="checklist__item checklist__item--cross">Generic ad copy anyone could write</li>
							<li class="checklist__item checklist__item--cross">Broad keywords with wasted spend</li>
							<li class="checklist__item checklist__item--cross">Sends all traffic to homepage</li>
							<li class="checklist__item checklist__item--cross">Monthly report, no real insights</li>
							<li class="checklist__item checklist__item--cross">Monthly call to update — often too late</li>
						</ul>
					</div>
					<div>
						<h3 class="compare-heading">Scaling SMB approach</h3>
						<ul class="checklist">
							<li class="checklist__item checklist__item--check">Ads built on your lived experience &amp; data</li>
							<li class="checklist__item checklist__item--check">Intent-based keyword grouping</li>
							<li class="checklist__item checklist__item--check">Dedicated landing pages per ad group</li>
							<li class="checklist__item checklist__item--check">Daily monitoring + weekly optimization</li>
							<li class="checklist__item checklist__item--check">Real-time alerts when something breaks</li>
						</ul>
					</div>
				</div>
			</div>
		</section>

		<!-- Who This Is For / Not For -->
		<section class="section section--dark">
			<div class="content-wrap">
				<header class="section-header">
					<p class="eyebrow">Is Adz right for you?</p>
					<h2>Perfect fit or pass</h2>
				</header>
				<div class="who-cols">
					<div class="who-col who-col--yes">
						<h3 class="who-col__title">✅ This is for you</h3>
						<ul class="who-list">
							<li>Service businesses (transport, legal, dental, aesthetic, trade, consulting)</li>
							<li>Local service areas (Macau, Hong Kong, APAC)</li>
							<li>Monthly ad spend from $500 to $20,000+</li>
							<li>Business owners who want results, not agency hand-holding</li>
						</ul>
					</div>
					<div class="who-col who-col--no">
						<h3 class="who-col__title">❌ This is NOT for you</h3>
						<ul class="who-list">
							<li>E-commerce stores (not my specialty)</li>
							<li>Global brands with $100k+/month budgets</li>
							<li>Anyone who wants weekly Zoom calls (you get reports, not meetings)</li>
						</ul>
					</div>
