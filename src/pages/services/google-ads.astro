---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { brand, contact, contactFormServiceOptions } from '../../content/site';
import ConsultationBooking from '../../components/landing/ConsultationBooking.astro';
import CtaBand from '../../components/landing/CtaBand.astro';
import Footer from '../../components/landing/Footer.astro';
import Header from '../../components/Header.astro';
import businessGrowthImg from '../../Images/blog-featured-images/Business Growth.jpeg';
import aiEmployeesImg from '../../Images/blog-featured-images/AI Employees.jpeg';
import softwareDevImg from '../../Images/blog-featured-images/sofware-development.jpeg';

const { scheduling } = contact;

const pageTitle = 'Adz — AI-Powered Google Ads Management | Scaling SMB';
const pageDesc =
	'Your campaigns. Running daily. Optimized hourly. Audited constantly. An AI-powered Google Ads strategist that monitors, optimizes, and reports — every single day. No agency bloat. No monthly updates that come too late.';
---
<BaseLayout title={pageTitle} description={pageDesc}>
	<Header />
	<main id="main" class="landing">

		<!-- Hero -->
		<section class="landing-hero ads-hero" aria-labelledby="ads-hero-title">
			<div class="landing-hero__bg-overlay" aria-hidden="true">
				<img src={businessGrowthImg.src} alt="" class="ads-hero__bg-img" />
			</div>
			<div class="landing-hero__inner ads-hero__inner">
				<div class="landing-hero__copy">
					<p class="eyebrow hero-anim ads-hero__eyebrow">Adz — AI Google Ads Agent</p>
					<h1 id="ads-hero-title" class="landing-hero__title hero-anim ads-hero__title">
						Your campaigns.<br />Running daily.<br />Optimized hourly.<br />Audited constantly.
					</h1>
					<p class="landing-hero__lede hero-anim ads-hero__lede">
						An AI-powered Google Ads strategist built for scaling service businesses. I connect directly to
						your account, audit everything, and optimize every day — so your budget works harder than your competitors.
					</p>
					<div class="landing-hero__actions hero-anim">
						<a class="btn btn--primary" href="#book">Book a free audit →</a>
					</div>
				</div>
			</div>
		</section>

		<!-- The Problem -->
		<section class="landing-section landing-wrap" data-reveal>
			<div class="landing-head landing-head--center">
				<p class="eyebrow">The real problem</p>
				<h2 class="landing-head__title">Why most Google Ads money burns</h2>
				<p class="landing-head__lede">
					Most businesses don't lose money on Google Ads because the platform doesn't work. They lose money because nobody's watching.
				</p>
			</div>
			<ul class="ads-problems">
				<li class="ads-problems__item" data-reveal>
					<span class="ads-problems__icon">⇢</span>
					<div><strong>Keywords drift</strong> — your ad shows up for searches you never intended</div>
				</li>
				<li class="ads-problems__item" data-reveal>
					<span class="ads-problems__icon">⇢</span>
					<div><strong>Competitors outbid you</strong> while you're not looking</div>
				</li>
				<li class="ads-problems__item" data-reveal>
					<span class="ads-problems__icon">⇢</span>
					<div><strong>Budget bleeds</strong> on irrelevant searches that have nothing to do with what you actually sell</div>
				</li>
				<li class="ads-problems__item" data-reveal>
					<span class="ads-problems__icon">⇢</span>
					<div><strong>Conversion tracking breaks</strong> and weeks go by before anyone notices</div>
				</li>
				<li class="ads-problems__item" data-reveal>
					<span class="ads-problems__icon">⇢</span>
					<div><strong>Agency updates come monthly</strong> — by then, you've already burned through your budget</div>
				</li>
			</ul>
			<p class="ads-problems__punch" data-reveal>
				You don't need more "best practices." You need someone actually in your account every day.
			</p>
		</section>

		<!-- What Is Adz -->
		<section class="landing-section" style="background:var(--bg-subtle)">
			<div class="landing-wrap">
				<div class="landing-head landing-head--center" data-reveal>
					<p class="eyebrow">Meet Adz</p>
					<h2 class="landing-head__title">An AI strategist that never sleeps</h2>
					<p class="landing-head__lede">
						I connect directly to your Google Ads account through the API — the same pipeline Google's own engineers use.
						I audit, strategize, build, launch, monitor, and optimize. Every day.
					</p>
				</div>
				<div class="adz-meet">
					<div class="adz-meet__cards">
						<article class="adz-card" data-reveal>
							<div class="adz-card__icon">🌙</div>
							<h3 class="adz-card__title">I don't sleep</h3>
							<p class="adz-card__desc">
								No weekends. No holidays. No pipeline of 30 other clients. Your account gets my full attention, every day.
							</p>
						</article>
						<article class="adz-card" data-reveal>
							<div class="adz-card__icon">⚡</div>
							<h3 class="adz-card__title">I act — not just report</h3>
							<p class="adz-card__desc">
								When I find a leak, I flag it and fix it. No waiting for a monthly call or "next quarter's plan."
							</p>
						</article>
						<article class="adz-card" data-reveal>
							<div class="adz-card__icon">🔍</div>
							<h3 class="adz-card__title">Full transparency</h3>
							<p class="adz-card__desc">
								Search term reports, channel breakdowns, every recommendation backed by real data. No black boxes. No hiding.
							</p>
						</article>
					</div>
					<div class="adz-meet__visual" data-reveal>
						<img src={aiEmployeesImg.src} alt="" class="adz-meet__img" loading="lazy" />
					</div>
				</div>
			</div>
		</section>

		<!-- What I Deliver -->
		<section class="landing-section landing-wrap">
			<div class="landing-head landing-head--center" data-reveal>
				<p class="eyebrow">What I deliver</p>
				<h2 class="landing-head__title">From audit to daily optimization</h2>
			</div>
			<div class="ads-deliver" data-reveal>
				<div class="ads-deliver__item">
					<div class="ads-deliver__head">
						<span class="ads-deliver__step">01</span>
						<h3 class="ads-deliver__title">Audit — Before You Spend Another Dollar</h3>
					</div>
					<p class="ads-deliver__desc">I pull 90 days of data from your account and find every leak within an hour:</p>
					<ul class="ads-deliver__list">
						<li>Search terms wasting your budget</li>
						<li>Missing negative keywords</li>
						<li>Broken conversion tracking</li>
						<li>Campaign structure problems</li>
						<li>Bidding strategy mismatches</li>
					</ul>
					<p class="ads-deliver__outcome"><strong>Deliverable:</strong> A written audit with specific dollars wasted and exactly what to fix.</p>
				</div>
				<div class="ads-deliver__item">
					<div class="ads-deliver__head">
						<span class="ads-deliver__step">02</span>
						<h3 class="ads-deliver__title">Strategy — Built From Real Data</h3>
					</div>
					<p class="ads-deliver__desc">I research your market through Google's own Keyword Planning API — real search volumes and CPCs, not third-party estimates. Then I build a campaign structure designed for how your customers actually search.</p>
					<ul class="ads-deliver__list">
						<li>Thematic ad groups (not SKAGs)</li>
						<li>Exact + Phrase + Broad match layered with negatives</li>
						<li>Ad copy tested against competitor angles</li>
						<li>Landing page alignment verified</li>
					</ul>
				</div>
				<div class="ads-deliver__item">
					<div class="ads-deliver__head">
						<span class="ads-deliver__step">03</span>
						<h3 class="ads-deliver__title">Build & Launch — 48 Hours</h3>
					</div>
					<p class="ads-deliver__desc">Everything is built inside your account via API. Paused and ready for your review. You approve, I launch. Within 48 hours of your sign-off, your campaigns are live.</p>
				</div>
				<div class="ads-deliver__item">
					<div class="ads-deliver__head">
						<span class="ads-deliver__step">04</span>
						<h3 class="ads-deliver__title">Daily Monitoring</h3>
					</div>
					<p class="ads-deliver__desc">Every morning you get a report:</p>
					<ul class="ads-deliver__list">
						<li>What spent and what converted</li>
						<li>New search terms — good and bad</li>
						<li>Recommendations for what to add or block</li>
					</ul>
					<p class="ads-deliver__outcome">No meetings. No status calls. Just data and action items.</p>
				</div>
				<div class="ads-deliver__item">
					<div class="ads-deliver__head">
						<span class="ads-deliver__step">05</span>
						<h3 class="ads-deliver__title">Weekly Optimization</h3>
					</div>
					<p class="ads-deliver__desc">Search term review → add winners, kill losers. Ad copy refresh → swap underperformers. Budget reallocation → move spend to what's working.</p>
				</div>
				<div class="ads-deliver__item">
					<div class="ads-deliver__head">
						<span class="ads-deliver__step">06</span>
						<h3 class="ads-deliver__title">Monthly Deep-Dive</h3>
					</div>
					<ul class="ads-deliver__list">
						<li>Bid strategy review → graduate to Smart Bidding</li>
						<li>Full account health check</li>
						<li>Conversion tracking verification across every layer</li>
					</ul>
				</div>
			</div>
		</section>

		<!-- Black Box Warning -->
		<section class="landing-section" style="background:var(--bg-subtle)">
			<div class="landing-wrap landing-head landing-head--center" data-reveal>
				<p class="eyebrow">The Black Box Warning</p>
				<h2 class="landing-head__title">You deserve to know where every dollar went</h2>
				<p class="landing-head__lede" style="max-width:44rem">
					Google's Performance Max campaigns are a black box. You give Google your budget and get back conversions — but you never see where your money actually went. We don't run black boxes. You get search term reports, channel breakdowns, and you get to see exactly what's working.
				</p>
			</div>
		</section>

		<!-- Pricing -->
		<section class="landing-section landing-wrap">
			<div class="landing-head landing-head--center" data-reveal>
				<p class="eyebrow">Pricing</p>
				<h2 class="landing-head__title">Simple, transparent, no surprises</h2>
				<p class="landing-head__lede">
					<strong>No percentage of ad spend. No markup on your budget. No platform fees.</strong>
					Just a flat monthly retainer plus a one-time setup.
				</p>
			</div>
			<div class="pricing-grid" data-reveal>
				<article class="pricing-card pricing-card--featured">
					<div class="pricing-card__badge">Most popular</div>
					<h3 class="pricing-card__tier">Starter</h3>
					<p class="pricing-card__revenue">Monthly ad spend up to $1,000</p>
					<div class="pricing-card__value">
						<span class="pricing-card__amount">$300</span>
						<span class="pricing-card__label">/month</span>
					</div>
					<div class="pricing-card__setup">+ <strong>$297</strong> one-time setup</div>
					<ul class="pricing-card__features">
						<li>Full account audit</li>
						<li>Campaign setup &amp; launch</li>
						<li>Daily monitoring</li>
						<li>Weekly optimization</li>
						<li>Monthly deep-dive report</li>
					</ul>
					<a class="btn btn--primary pricing-card__btn" href="#book">Book a free audit →</a>
				</article>
				<article class="pricing-card">
					<h3 class="pricing-card__tier">Growth</h3>
					<p class="pricing-card__revenue">Monthly ad spend $1,000 – $5,000</p>
					<div class="pricing-card__value">
						<span class="pricing-card__amount">$500</span>
						<span class="pricing-card__label">/month</span>
					</div>
					<div class="pricing-card__setup">+ <strong>$297</strong> one-time setup</div>
					<ul class="pricing-card__features">
						<li>Everything in Starter</li>
						<li>Competitor analysis</li>
						<li>Weekly ad copy refresh</li>
						<li>A/B testing</li>
					</ul>
					<a class="btn btn--ghost pricing-card__btn" href="#book">Book a free audit →</a>
				</article>
				<article class="pricing-card">
					<h3 class="pricing-card__tier">Scale</h3>
					<p class="pricing-card__revenue">Monthly ad spend $5,000+</p>
					<div class="pricing-card__value">
						<span class="pricing-card__amount">Contact us</span>
					</div>
					<div class="pricing-card__setup">Custom retainer + <strong>$297</strong> setup</div>
					<ul class="pricing-card__features">
						<li>Everything in Growth</li>
						<li>Dedicated strategy</li>
						<li>Advanced reporting</li>
						<li>Priority support</li>
					</ul>
					<a class="btn btn--ghost pricing-card__btn" href="#book">Book a free audit →</a>
				</article>
			</div>
		</section>

		<!-- Agency Cost Comparison -->
		<section class="landing-section" style="background:var(--bg-subtle)">
			<div class="landing-wrap">
				<div class="landing-head landing-head--center" data-reveal>
					<p class="eyebrow">Compare for yourself</p>
					<h2 class="landing-head__title">Adz vs a traditional agency</h2>
					<p class="landing-head__lede">
						Most agencies charge 10–20% of your ad spend or a $1,000+ monthly retainer — and you only hear from them once a month.
					</p>
				</div>
				<div class="compare-layout" data-reveal>
					<div class="compare-table-wrap">
						<table class="compare-table">
							<thead>
								<tr>
									<th></th>
									<th class="compare-th compare-th--bad">Traditional Agency</th>
									<th class="compare-th compare-th--good">Adz — AI Agent</th>
								</tr>
							</thead>
							<tbody>
								<tr><td class="compare-label">Monthly retainer</td><td class="compare-cell compare-cell--bad">$1,000 – $3,000</td><td class="compare-cell compare-cell--good">$300 – $500</td></tr>
								<tr><td class="compare-label">Setup fee</td><td class="compare-cell compare-cell--bad">$500 – $1,500</td><td class="compare-cell compare-cell--good">$297</td></tr>
								<tr><td class="compare-label">% of ad spend</td><td class="compare-cell compare-cell--bad">10–20%</td><td class="compare-cell compare-cell--good">0%</td></tr>
								<tr><td class="compare-label">Account access</td><td class="compare-cell compare-cell--bad">Monthly updates</td><td class="compare-cell compare-cell--good">Daily monitoring</td></tr>
								<tr><td class="compare-label">Search term review</td><td class="compare-cell compare-cell--bad">Monthly</td><td class="compare-cell compare-cell--good">Weekly (live)</td></tr>
								<tr><td class="compare-label">Ad copy refresh</td><td class="compare-cell compare-cell--bad">Quarterly</td><td class="compare-cell compare-cell--good">Weekly</td></tr>
								<tr><td class="compare-label">Response time</td><td class="compare-cell compare-cell--bad">Business hours</td><td class="compare-cell compare-cell--good">24/7</td></tr>
							</tbody>
						</table>
					</div>
					<div class="compare-visual">
						<img src={softwareDevImg.src} alt="" class="compare-img" loading="lazy" />
					</div>
				</div>
				<div class="compare-savings" data-reveal>
					<p class="compare-savings__line"><strong>Typical annual savings with Adz:</strong> <span class="compare-savings__amount">$8,000 – $30,000+</span> vs a traditional agency.</p>
					<p class="compare-savings__sub">And you get better service. That's not a trade-off — that's what happens when you remove agency overhead.</p>
				</div>
			</div>
		</section>

		<!-- How We Start -->
		<section class="landing-section landing-wrap">
			<div class="landing-head landing-head--center" data-reveal>
				<p class="eyebrow">How we start</p>
				<h2 class="landing-head__title">From hello to live campaigns</h2>
			</div>
			<div class="ads-start" data-reveal>
				<article class="ads-start__step">
					<span class="ads-start__num">01</span>
					<div class="ads-start__body">
						<h3 class="ads-start__title">You sign up for a Google Ads account</h3>
						<p class="ads-start__desc">Use your business email at ads.google.com and add your billing info.</p>
					</div>
				</article>
				<article class="ads-start__step">
					<span class="ads-start__num">02</span>
					<div class="ads-start__body">
						<h3 class="ads-start__title">Link to our MCC</h3>
						<p class="ads-start__desc">We send the request, you accept. We're in your account within minutes.</p>
					</div>
				</article>
				<article class="ads-start__step">
					<span class="ads-start__num">03</span>
					<div class="ads-start__body">
						<h3 class="ads-start__title">Audit or build from scratch</h3>
						<p class="ads-start__desc">Within 24 hours, we pull 90 days of data and find every leak. Or if you're starting fresh, we build campaigns from the ground up.</p>
					</div>
				</article>
				<article class="ads-start__step">
					<span class="ads-start__num">04</span>
					<div class="ads-start__body">
						<h3 class="ads-start__title">You review, approve, we launch</h3>
						<p class="ads-start__desc">Total setup time: 48 hours from your sign-off. After that, daily monitoring begins.</p>
					</div>
				</article>
			</div>
			<div style="text-align:center;margin-top:1.5rem" data-reveal>
				<a class="btn btn--primary" href="#book">Start with a free audit →</a>
			</div>
		</section>

		<!-- The tech section -->
		<section class="landing-section" style="background:var(--bg-subtle)">
			<div class="landing-wrap">
				<div class="landing-head landing-head--center" data-reveal>
					<p class="eyebrow">The tech behind Adz</p>
					<h2 class="landing-head__title">How it actually works</h2>
				</div>
				<div class="tech-grid" data-reveal>
					<div class="tech-item">
						<span class="tech-item__icon">📖</span>
						<div class="tech-item__body">
							<h3 class="tech-item__title">Read your account</h3>
							<p class="tech-item__desc">GAQL queries via Google Ads API</p>
						</div>
					</div>
					<div class="tech-item">
						<span class="tech-item__icon">🔧</span>
						<div class="tech-item__body">
							<h3 class="tech-item__title">Build campaigns</h3>
							<p class="tech-item__desc">Full mutation support — budgets, keywords, ads, extensions</p>
						</div>
					</div>
					<div class="tech-item">
						<span class="tech-item__icon">🔍</span>
						<div class="tech-item__body">
							<h3 class="tech-item__title">Research keywords</h3>
							<p class="tech-item__desc">KeywordPlanIdeaService — real volumes, CPCs, competition</p>
						</div>
					</div>
					<div class="tech-item">
						<span class="tech-item__icon">✅</span>
						<div class="tech-item__body">
							<h3 class="tech-item__title">Check tracking</h3>
							<p class="tech-item__desc">GTM API + Analytics Data API + live verification</p>
						</div>
					</div>
					<div class="tech-item">
						<span class="tech-item__icon">🎯</span>
						<div class="tech-item__body">
							<h3 class="tech-item__title">Optimize bids</h3>
							<p class="tech-item__desc">Bidding strategy via CampaignService + FieldMasks</p>
						</div>
					</div>
					<div class="tech-item">
						<span class="tech-item__icon">📱</span>
						<div class="tech-item__body">
							<h3 class="tech-item__title">Monitor daily</h3>
							<p class="tech-item__desc">Cron-delivered reports to your phone</p>
						</div>
					</div>
					<div class="tech-item">
						<span class="tech-item__icon">🔄</span>
						<div class="tech-item__body">
							<h3 class="tech-item__title">Stay current</h3>
							<p class="tech-item__desc">Self-updating — checks Google's docs daily</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Non-commodity difference -->
		<section class="landing-section landing-wrap">
			<div class="landing-head landing-head--center" data-reveal>
				<p class="eyebrow">Our edge</p>
				<h2 class="landing-head__title">Non-commodity ad copy</h2>
				<p class="landing-head__lede">
					Most Google Ads use generic templates that look and sound the same. We write ads built on your actual business data — ads that can't be replicated.
				</p>
			</div>
			<div class="adz-compare-cols" data-reveal>
				<div class="adz-col adz-col--bad">
					<h3 class="adz-col__heading">Typical agency</h3>
					<ul class="adz-checklist">
						<li class="adz-checklist__x">Generic ad copy anyone could write</li>
						<li class="adz-checklist__x">Broad keywords with wasted spend</li>
						<li class="adz-checklist__x">Sends all traffic to homepage</li>
						<li class="adz-checklist__x">Monthly report, no real insights</li>
						<li class="adz-checklist__x">Monthly call — often too late</li>
					</ul>
				</div>
				<div class="adz-col adz-col--good">
					<h3 class="adz-col__heading">Scaling SMB approach</h3>
					<ul class="adz-checklist">
						<li class="adz-checklist__check">Ads built on your lived experience &amp; data</li>
						<li class="adz-checklist__check">Intent-based keyword grouping</li>
						<li class="adz-checklist__check">Dedicated landing pages per ad group</li>
						<li class="adz-checklist__check">Daily monitoring + weekly optimization</li>
						<li class="adz-checklist__check">Real-time alerts when something breaks</li>
					</ul>
				</div>
			</div>
		</section>

		<!-- Is This For You -->
		<section class="landing-section" style="background:var(--bg-subtle)">
			<div class="landing-wrap">
				<div class="landing-head landing-head--center" data-reveal>
					<p class="eyebrow">Is Adz right for you?</p>
					<h2 class="landing-head__title">Perfect fit or pass</h2>
				</div>
				<div class="adz-who" data-reveal>
					<div class="adz-who__col">
						<h3 class="adz-who__title adz-who__title--yes">✅ This is for you</h3>
						<ul class="adz-who__list">
							<li>Service businesses (transport, legal, dental, aesthetic, trade, consulting)</li>
							<li>Local service areas (Macau, Hong Kong, APAC)</li>
							<li>Monthly ad spend from $500 to $20,000+</li>
							<li>Business owners who want results, not hand-holding</li>
						</ul>
					</div>
					<div class="adz-who__col">
						<h3 class="adz-who__title adz-who__title--no">❌ This is NOT for you</h3>
						<ul class="adz-who__list">
							<li>E-commerce stores (not my specialty)</li>
							<li>Global brands with $100k+/month budgets</li>
							<li>Anyone who wants weekly Zoom calls (you get reports, not meetings)</li>
						</ul>
					</div>
				</div>
			</div>
		</section>

		<!-- Book a consultation -->
		<section class="landing-section landing-wrap" id="book">
			<div class="landing-head landing-head--center" data-reveal>
				<p class="eyebrow">Get started</p>
				<h2 class="landing-head__title">One audit. One conversation. No commitment.</h2>
				<p class="landing-head__lede">
					You'll know exactly what's wrong with your Google Ads account — and exactly how to fix it — before you spend another dollar.
				</p>
			</div>
			<div class="ads-booking" data-reveal>
				<ConsultationBooking
					meetingTitle={scheduling.meetingTitle}
					duration={scheduling.duration}
					description={scheduling.description}
					features={[...scheduling.features]}
					timeSlots={[...scheduling.timeSlots]}
					blockedTimeSlots={[...scheduling.blockedTimeSlots]}
					timezones={[...scheduling.timezones]}
					serviceOptions={contactFormServiceOptions}
					stepLabels={[...scheduling.steps]}
					stepTitles={scheduling.stepTitles}
					success={scheduling.success}
					contactEmail={contact.email}
				/>
			</div>
		</section>

	</main>
	<CtaBand />
	<Footer />
</BaseLayout>

