---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/landing/Footer.astro';
import Header from '../components/Header.astro';
import { notFound } from '../content/site';
---

<BaseLayout title={notFound.title} description={notFound.description} noindex>
	<Header />
	<main id="main" class="landing">
		<section class="landing-section landing-wrap not-found" aria-labelledby="not-found-title">
			<p class="eyebrow">{notFound.eyebrow}</p>
			<h1 id="not-found-title" class="landing-head__title">{notFound.headline}</h1>
			<p class="landing-head__lede">{notFound.lede}</p>
			<div class="not-found__actions">
				<a class="btn btn--primary" href="/">{notFound.home}</a>
				<a class="btn btn--ghost" href="/#contact">{notFound.cta}</a>
			</div>
		</section>
	</main>
	<Footer />
</BaseLayout>

<style>
	.not-found {
		text-align: center;
		padding-top: calc(var(--header-height) + clamp(3rem, 8vw, 5rem));
		min-height: min(70vh, 36rem);
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	.not-found .landing-head__lede {
		margin-inline: auto;
	}
	.not-found__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		justify-content: center;
		margin-top: 1.75rem;
	}
</style>
